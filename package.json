{
  "name": "shasn",
  "private": true,
  "version": "0.0.0",
  "description": "Digital Shasn — server-authoritative online multiplayer",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build --workspaces --if-present",
    "start": "node scripts/start.mjs",
    "preflight": "node scripts/preflight.mjs",
    "kill-stale": "node scripts/kill-stale.mjs",
    "check": "npm run typecheck && npm run validate && npm run balance && npm test",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "validate": "npm run validate --workspaces --if-present",
    "balance": "npm run balance --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  }
}
