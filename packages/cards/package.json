{
  "name": "@shasn/cards",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shasn card corpus: JSON deck data, JSON Schema, validator and balance checker. The deck data itself is dependency-free.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "validate": "tsx scripts/validate.ts",
    "balance": "tsx scripts/balance.ts",
    "playable": "tsx scripts/playable.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "ajv": "^8.17.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
